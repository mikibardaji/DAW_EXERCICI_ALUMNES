package exercici5_provenshare;

import java.util.Scanner;

/**
 *
 * @author Caire
 */
public class Exercici5_provenshare {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner teclado = new Scanner (System.in);
        
       double euros,creditos;
       
       //mostrar cuantos eutos quiere convertir
        System.out.println("Cuantos euros quieres convertir");
        
        //esperamos euros
        
        euros = teclado.nextDouble();
        
        //calculamos los creditos y como sabemos se debera de multi*8
        
        creditos = euros * 8;
        
        //mostramos todos los creditos en total
        System.out.println("Tienes" + creditos);
        
        
    }
    
}
