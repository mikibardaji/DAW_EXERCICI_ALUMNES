package exercici_sequencials_6;

import java.util.Scanner;

/**
 *
 * @author Caire
 */
public class Exercici_sequencials_6 {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
               Scanner sc = new Scanner(System.in);
              
               System.out.println("Introduce el precio total");
               double Precio_Total = sc.nextDouble();
               
               System.out.println("Introduce el descuento %");
               double mostrar_descuento = sc.nextDouble();
               
               double coste_final = Precio_Total - (Precio_Total * mostrar_descuento /100 );
               
               System.out.println("El Prodcuto tiene un costo de:" + coste_final);
                       
    }
    
}
