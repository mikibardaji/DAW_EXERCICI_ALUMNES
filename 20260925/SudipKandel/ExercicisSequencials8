        double temperatura_fahrenheit, temperatura_celsius;

Scanner teclado = new Scanner(System.in);

// Mostrar “¿Cuál es la temperatura en Fahrenheit?”
System.out.println("Cual es la temperatura en Fahrenheit?");

// Esperar temperatura_fahrenheit
